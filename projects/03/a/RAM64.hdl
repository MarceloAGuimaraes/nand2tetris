// File name: projects/03/a/RAM64.hdl

/**
 * Memory of 64 registers, each 16 bit-wide. Out holds the value
 * stored at the memory location specified by address. If load==1, then 
 * the in value is loaded into the memory location specified by address 
 * (the loaded value will be emitted to out from the next time step onward).
 */

CHIP RAM64 {
    IN in[16], load, address[6];
    OUT out[16];

    PARTS:
    // selecting what attribute needs to change
    DMux8Way(in=load, sel=address[0..2], a=checkedA, b=checkedB, c=checkedC, d=checkedD, e=checkedE, f=checkedF, g=checkedG, h=checkedH);

    RAM8(in=in, load=checkedA, address=address[3..5], out=a);
    RAM8(in=in, load=checkedB, address=address[3..5], out=b);
    RAM8(in=in, load=checkedC, address=address[3..5], out=c);
    RAM8(in=in, load=checkedD, address=address[3..5], out=d);
    RAM8(in=in, load=checkedE, address=address[3..5], out=e);
    RAM8(in=in, load=checkedF, address=address[3..5], out=f);
    RAM8(in=in, load=checkedG, address=address[3..5], out=g);
    RAM8(in=in, load=checkedH, address=address[3..5], out=h);

    // deciding what chip value
    Mux8Way16(a=a, b=b, c=c, d=d, e=e, f=f, g=g, h=h, sel=address[0..2], out=out);
}