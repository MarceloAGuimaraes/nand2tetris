// File name: projects/03/a/RAM8.hdl

/**
 * Memory of 8 registers, each 16 bit-wide. Out holds the value
 * stored at the memory location specified by address. If load==1, then 
 * the in value is loaded into the memory location specified by address 
 * (the loaded value will be emitted to out from the next time step onward).
 */

CHIP RAM8 {
    IN in[16], load, address[3];
    OUT out[16];

    PARTS:
    // selecting what attribute needs to change
    DMux8Way(in=load, sel=address, a=checkedA, b=checkedB, c=checkedC, d=checkedD, e=checkedE, f=checkedF, g=checkedG, h=checkedH);

    // registering the new value returned
    Register(in=in, load=checkedA, out=lastA);
    Register(in=in, load=checkedB, out=lastB);
    Register(in=in, load=checkedC, out=lastC);
    Register(in=in, load=checkedD, out=lastD);
    Register(in=in, load=checkedE, out=lastE);
    Register(in=in, load=checkedF, out=lastF);
    Register(in=in, load=checkedG, out=lastG);
    Register(in=in, load=checkedH, out=lastH);

    // deciding what address value
    Mux8Way16(a=lastA, b=lastB, c=lastC, d=lastD, e=lastE, f=lastF, g=lastG, h=lastH, sel=address, out=out);
}